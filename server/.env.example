PORT=3005
DB_PATH=./data/projecthub.db
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3005

# Secret for signing auth JWTs (HS256). REQUIRED in production; dev uses a
# default. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Session lifetime in seconds (default 604800 = 7 days).
JWT_EXPIRES_SEC=604800

# GitHub Personal Access Token used by extensions/shared/git/create-repo.js.
# classic PAT: `repo` scope · fine-grained PAT: "Administration: read & write".
# Optional — only needed to create repos. Set the real value in .env (gitignored).
GITHUB_TOKEN=

# Base directory under which create-repo.js makes the local repo dir
# (<PROJECT_DIR>/<repo-name>, git-inited with `origin` set to the new repo).
PROJECT_DIR=