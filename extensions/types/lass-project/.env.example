# Settings for the "othot-swe-work" project type.
# Copy to `.env` in this same directory and adjust. Loaded by
# settings/settings.js; read by this type's buttons & hooks.

# Default Git repository used by the Clone button / after-create hook when a
# project doesn't carry its own `gitRepoUrl` field.
GIT_URL=https://github.com/your-org/your-repo.git
CLONE_BASE_DIR=
# Optional base directory for clones. A project's `gitClone` (relative path)
# resolves against this. Leave unset to use the server process cwd.
# CLONE_BASE_DIR=/abs/path/to/workspaces
